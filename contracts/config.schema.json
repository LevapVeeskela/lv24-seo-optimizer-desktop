{
  "$comment": "Generated from lv24-seo 0.13.1 SeoConfig.model_json_schema(). Do not edit by hand.",
  "$defs": {
    "AuthConfig": {
      "additionalProperties": false,
      "description": "OAuth client registrations used by ``lv24-seo auth login`` (``[auth]``).",
      "properties": {
        "gsc": {
          "$ref": "#/$defs/OAuthClientConfig"
        },
        "yandex": {
          "$ref": "#/$defs/OAuthClientConfig"
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "BingConfig": {
      "additionalProperties": false,
      "description": "Bing Webmaster Tools site and the public IndexNow identifiers.\n\n``indexnow_key`` and ``indexnow_key_location`` are public identifiers, not secrets: the\nkey file is served openly at ``key_location`` (or ``https://<host>/<key>.txt``) and the\nsame value is sent in every IndexNow request. They are safe to keep in ``seo.toml``.\nThe Bing Webmaster API key is a secret and stays in the secret store.",
      "properties": {
        "indexnow_key": {
          "default": "",
          "title": "Indexnow Key",
          "type": "string"
        },
        "indexnow_key_location": {
          "default": "",
          "title": "Indexnow Key Location",
          "type": "string"
        },
        "site": {
          "default": "",
          "title": "Site",
          "type": "string"
        }
      },
      "title": "BingConfig",
      "type": "object"
    },
    "CrawlConfig": {
      "additionalProperties": false,
      "description": "Crawler limits. ``respect_robots`` stays on unless a user opts out explicitly.\n\nCrawling is serial with polite pacing (robots ``Crawl-delay`` between\nrequests); ``concurrency`` is reserved for a future bounded worker pool and\ncurrently has no effect on execution.",
      "properties": {
        "concurrency": {
          "default": 4,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "max_urls": {
          "default": 500,
          "minimum": 1,
          "title": "Max Urls",
          "type": "integer"
        },
        "respect_robots": {
          "default": true,
          "title": "Respect Robots",
          "type": "boolean"
        },
        "user_agent": {
          "default": "lv24-seo/0.1",
          "title": "User Agent",
          "type": "string"
        }
      },
      "title": "CrawlConfig",
      "type": "object"
    },
    "CruxConfig": {
      "additionalProperties": false,
      "description": "Chrome UX Report origin.",
      "properties": {
        "origin": {
          "default": "",
          "title": "Origin",
          "type": "string"
        }
      },
      "title": "CruxConfig",
      "type": "object"
    },
    "EmailConfig": {
      "additionalProperties": false,
      "description": "Email delivery settings. ``from`` is a keyword, hence the alias.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "from": {
          "default": "",
          "title": "From",
          "type": "string"
        },
        "only_on_change": {
          "default": true,
          "title": "Only On Change",
          "type": "boolean"
        },
        "smtp_host": {
          "default": "",
          "title": "Smtp Host",
          "type": "string"
        },
        "smtp_port": {
          "default": 587,
          "maximum": 65535,
          "minimum": 1,
          "title": "Smtp Port",
          "type": "integer"
        },
        "smtp_user": {
          "default": "",
          "title": "Smtp User",
          "type": "string"
        },
        "to": {
          "items": {
            "type": "string"
          },
          "title": "To",
          "type": "array"
        }
      },
      "title": "EmailConfig",
      "type": "object"
    },
    "GscConfig": {
      "additionalProperties": false,
      "description": "Google Search Console property and credential source.\n\n``service_account_file`` is an absolute path to a service-account JSON key and is\nconfiguration, not a secret; the key itself stays outside the repository. A relative\npath is rejected at use time because it would depend on the working directory.",
      "properties": {
        "auth": {
          "default": "keychain",
          "title": "Auth",
          "type": "string"
        },
        "property": {
          "default": "",
          "title": "Property",
          "type": "string"
        },
        "service_account_file": {
          "default": "",
          "title": "Service Account File",
          "type": "string"
        }
      },
      "title": "GscConfig",
      "type": "object"
    },
    "IndexingConfig": {
      "additionalProperties": false,
      "description": "Quota-aware submission and index-check automation (``[indexing]``).\n\nDisabled by default: provider writes are an explicit opt-in. ``providers`` selects which\nengines participate; a provider that is not configured is reported, never guessed.\n``max_submit_per_run`` bounds one run globally, ``max_inspect_per_run`` bounds the\nread-only URL checks (GSC URL Inspection and Bing ``GetUrlInfo``), and the two daily\nlimits are local caps because those providers expose no remaining-count endpoint.\n``stale_days`` marks stored state older than the threshold in ``indexing status``;\n``check_interval_days`` is the re-check cadence used by the planner.",
      "properties": {
        "check_interval_days": {
          "default": 7,
          "maximum": 3660,
          "minimum": 0,
          "title": "Check Interval Days",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "gsc_inspect_daily_limit": {
          "default": 2000,
          "maximum": 50000,
          "minimum": 0,
          "title": "Gsc Inspect Daily Limit",
          "type": "integer"
        },
        "indexnow_daily_limit": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 0,
          "title": "Indexnow Daily Limit",
          "type": "integer"
        },
        "max_inspect_per_run": {
          "default": 20,
          "maximum": 1000,
          "minimum": 0,
          "title": "Max Inspect Per Run",
          "type": "integer"
        },
        "max_submit_per_run": {
          "default": 500,
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Submit Per Run",
          "type": "integer"
        },
        "providers": {
          "items": {
            "enum": [
              "bing",
              "yandex",
              "gsc",
              "indexnow"
            ],
            "type": "string"
          },
          "title": "Providers",
          "type": "array"
        },
        "stale_days": {
          "default": 7,
          "maximum": 3660,
          "minimum": 0,
          "title": "Stale Days",
          "type": "integer"
        }
      },
      "title": "IndexingConfig",
      "type": "object"
    },
    "OAuthClientConfig": {
      "additionalProperties": false,
      "description": "Public OAuth client settings for one provider.\n\n``client_id`` is public and may live in ``seo.toml``. The client secret is **not**\npart of this model: it is stored in the OS keychain (``<provider>_oauth_client_secret``)\nand never serialized into the config or an envelope.",
      "properties": {
        "client_id": {
          "default": "",
          "title": "Client Id",
          "type": "string"
        },
        "redirect_uri": {
          "default": "",
          "title": "Redirect Uri",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "title": "OAuthClientConfig",
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "description": "Identity of the site this workspace reports on.",
      "properties": {
        "base_url": {
          "default": "",
          "title": "Base Url",
          "type": "string"
        },
        "default_property": {
          "default": "",
          "title": "Default Property",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        }
      },
      "title": "ProjectConfig",
      "type": "object"
    },
    "ProvidersConfig": {
      "additionalProperties": false,
      "description": "Optional provider blocks; absent means \"not configured\", not a failure.",
      "properties": {
        "bing": {
          "anyOf": [
            {
              "$ref": "#/$defs/BingConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crux": {
          "anyOf": [
            {
              "$ref": "#/$defs/CruxConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gsc": {
          "anyOf": [
            {
              "$ref": "#/$defs/GscConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "psi": {
          "anyOf": [
            {
              "$ref": "#/$defs/PsiConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "yandex_metrika": {
          "anyOf": [
            {
              "$ref": "#/$defs/YandexMetrikaConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "yandex_webmaster": {
          "anyOf": [
            {
              "$ref": "#/$defs/YandexWebmasterConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ProvidersConfig",
      "type": "object"
    },
    "PsiConfig": {
      "additionalProperties": false,
      "description": "PageSpeed Insights defaults.",
      "properties": {
        "strategy": {
          "default": "mobile",
          "enum": [
            "mobile",
            "desktop"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "urls": {
          "items": {
            "type": "string"
          },
          "title": "Urls",
          "type": "array"
        }
      },
      "title": "PsiConfig",
      "type": "object"
    },
    "ReportConfig": {
      "additionalProperties": false,
      "description": "Report locale, schedule and delivery channels.",
      "properties": {
        "email": {
          "$ref": "#/$defs/EmailConfig"
        },
        "locale": {
          "default": "ru",
          "enum": [
            "ru",
            "en",
            "zh"
          ],
          "title": "Locale",
          "type": "string"
        },
        "telegram": {
          "$ref": "#/$defs/TelegramConfig"
        },
        "thresholds": {
          "$ref": "#/$defs/ThresholdsConfig"
        },
        "timezone": {
          "default": "Europe/Minsk",
          "title": "Timezone",
          "type": "string"
        },
        "week_start": {
          "default": "monday",
          "enum": [
            "monday",
            "sunday"
          ],
          "title": "Week Start",
          "type": "string"
        }
      },
      "title": "ReportConfig",
      "type": "object"
    },
    "StorageConfig": {
      "additionalProperties": false,
      "description": "Local data directory and raw-response retention.\n\nA relative ``data_dir`` written in a config file is anchored to that file's directory by\n:func:`load_config`; the built-in default and ``LV24_SEO_DATA_DIR`` stay relative to the\nprocess working directory.",
      "properties": {
        "data_dir": {
          "default": "data",
          "format": "path",
          "title": "Data Dir",
          "type": "string"
        },
        "raw_retention_days": {
          "default": 90,
          "minimum": 0,
          "title": "Raw Retention Days",
          "type": "integer"
        }
      },
      "title": "StorageConfig",
      "type": "object"
    },
    "TelegramConfig": {
      "additionalProperties": false,
      "description": "Telegram delivery settings.",
      "properties": {
        "chat_id": {
          "default": "",
          "title": "Chat Id",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "severity": {
          "default": "critical",
          "enum": [
            "critical",
            "all"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "title": "TelegramConfig",
      "type": "object"
    },
    "ThresholdsConfig": {
      "additionalProperties": false,
      "description": "Report movement thresholds, in percent or absolute positions.",
      "properties": {
        "clicks_pct": {
          "default": 10.0,
          "title": "Clicks Pct",
          "type": "number"
        },
        "impressions_pct": {
          "default": 15.0,
          "title": "Impressions Pct",
          "type": "number"
        },
        "position_abs": {
          "default": 1.5,
          "title": "Position Abs",
          "type": "number"
        }
      },
      "title": "ThresholdsConfig",
      "type": "object"
    },
    "YandexMetrikaConfig": {
      "additionalProperties": false,
      "description": "Yandex Metrika counter and the goals that count as conversions.",
      "properties": {
        "counter": {
          "default": "",
          "title": "Counter",
          "type": "string"
        },
        "goals": {
          "items": {
            "type": "integer"
          },
          "title": "Goals",
          "type": "array"
        }
      },
      "title": "YandexMetrikaConfig",
      "type": "object"
    },
    "YandexWebmasterConfig": {
      "additionalProperties": false,
      "description": "Yandex Webmaster host id, for example ``https:example.com:443``.",
      "properties": {
        "host_id": {
          "default": "",
          "title": "Host Id",
          "type": "string"
        }
      },
      "title": "YandexWebmasterConfig",
      "type": "object"
    }
  },
  "$id": "https://github.com/LevapVeeskela/lv24-seo-optimizer-desktop/contracts/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Validated, fully-defaulted configuration for one SEO workspace.",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthConfig"
    },
    "crawl": {
      "$ref": "#/$defs/CrawlConfig"
    },
    "indexing": {
      "$ref": "#/$defs/IndexingConfig"
    },
    "project": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "providers": {
      "$ref": "#/$defs/ProvidersConfig"
    },
    "report": {
      "$ref": "#/$defs/ReportConfig"
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig"
    }
  },
  "title": "SeoConfig",
  "type": "object"
}
