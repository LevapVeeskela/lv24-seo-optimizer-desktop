# Logs (runtime output at the repo root only; source folders such as
# src/pages/logs must stay tracked)
/logs
*.log
npm-debug.log*

# Frontend
node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# Locally built installers and portable archives (release artifacts, not source)
release/

# Rust / Tauri
src-tauri/target
src-tauri/gen/schemas

# Downloaded engine sidecars (populated by scripts/fetch-engine.mjs)
src-tauri/binaries/

# PyInstaller onedir engine (built by scripts/build-sidecar.py, bundled by Tauri)
src-tauri/engine/
build/
dist-sidecar/
*.spec

# Python tooling used by the contract generator and sidecar builder
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Contract generation scratch space
contracts/.tmp/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Update signing keys must never be committed. The public key lives in
# src-tauri/tauri.conf.json; the private key is a CI secret.
*.key
*.key.pub
*.password
